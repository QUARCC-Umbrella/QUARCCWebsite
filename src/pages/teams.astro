---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import MemberCard from "../components/MemberCard.astro";
import { getJoinContent, getTeams, toContentSlug } from "../lib/content";
import { CONTACT, ORG_ID, absoluteUrl, breadcrumbSchema } from "../lib/site";

const teams = await getTeams();
const isAlumni = (team: (typeof teams)[number]) => toContentSlug(team.id) === "alumni";
const current = teams.filter((team) => !isAlumni(team));
const alumni = teams.filter(isAlumni).flatMap((team) => team.data.members);
const person = (member: { name: string; linkedin: string }) => ({
  "@type": "Person",
  name: member.name,
  ...(member.linkedin ? { sameAs: [member.linkedin] } : {}),
});
const join = await getJoinContent();
const qrgRows = join.paths.cards.find((card) => card.label === "QRG")?.rows ?? [];
const coDirectors = qrgRows.find(([label]) => label.toLowerCase().startsWith("co-director"))?.[1];

const schema = [
  {
    "@type": "AboutPage",
    url: absoluteUrl("/teams/"),
    name: "The people behind QUARCC",
    about: {
      "@id": ORG_ID,
      member: current.flatMap((team) =>
        team.data.members.map((member) => ({
          "@type": "OrganizationRole",
          roleName: member.role,
          member: person(member),
        })),
      ),
      ...(alumni.length ? { alumni: alumni.map(person) } : {}),
    },
  },
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Teams", path: "/teams/" },
  ]),
];
---

<BaseLayout
  title="Teams | The People Behind QUARCC"
  description="Meet QUARCC's Executive Council, the Research Leads who manage our paper portfolios, the Quantitative Analysts on our systematic-trading curriculum, and our co-founders and alumni."
  schema={schema}
>
  <PageHero
    title={["The people", "behind QUARCC"]}
    sub="An executive council that runs the club, and a research group of leads and analysts who manage our paper portfolios."
  />

  <section class="teams-stats">
    <div class="wrap">
      <div class="stat-strip stat-strip--3">
        {current.map((team) => (
          <a class="stat" href={`#${toContentSlug(team.id)}`}>
            <p class="stat__head"><span class="stat__num">{team.data.members.length}</span><span class="stat__name">{team.data.name}</span></p>
            <p class="stat__body">{team.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {teams.map((team) => (
    <section class="section team-section" id={toContentSlug(team.id)} aria-labelledby={`${toContentSlug(team.id)}-title`}>
      <div class="wrap">
        <SectionHead id={`${toContentSlug(team.id)}-title`} title={[team.data.name]} sub={team.data.description} />
        {toContentSlug(team.id) === "qrg" && coDirectors ? (
          <p class="qrg-banner">
            <span class="label">QRG</span>
            <span>Co-Directors: {coDirectors}</span>
            <span aria-hidden="true">·</span>
            <a href={`mailto:${CONTACT.researchEmail}`}>{CONTACT.researchEmail}</a>
          </p>
        ) : null}
        <div class="grid grid-4">
          {team.data.members.map((member) => <MemberCard {...member} />)}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
