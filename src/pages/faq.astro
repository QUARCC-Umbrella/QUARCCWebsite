---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqList from "../components/FaqList.astro";
import { getFaq } from "../lib/content";
import { CONTACT, absoluteUrl, breadcrumbSchema } from "../lib/site";

const faq = await getFaq();

const schema = [
  {
    "@type": "FAQPage",
    url: absoluteUrl("/faq/"),
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "FAQ", path: "/faq/" },
  ]),
];
---

<BaseLayout
  title="FAQ | Joining QUARCC, Meetings and Workshops"
  description="Who can join QUARCC, prerequisites, when and where we meet, workshops and training, how to apply, and how the club and research group are structured."
  schema={schema}
>
  <PageHero
    title={["Frequently asked."]}
    sub="Everything students ask before their first meeting. Anything else? Ask us on Discord."
  >
    <div class="hero-actions">
      <a class="btn btn--cream" href={CONTACT.discord} target="_blank" rel="noopener noreferrer">Ask on Discord <span class="arrow">↗</span></a>
      <a class="btn btn--navy" href="/join/">How to join</a>
    </div>
  </PageHero>

  <section class="section faq-page" aria-label="Questions and answers">
    <div class="wrap">
      <FaqList items={faq} headingLevel="h2" />
    </div>
  </section>
</BaseLayout>
