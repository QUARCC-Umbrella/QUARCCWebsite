---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperFundClient from "../components/PaperFundClient.jsx";
import { getPortfolios, toContentSlug } from "../lib/content";

const entries = await getPortfolios();
const portfolios = entries.map((entry) => ({
  id: toContentSlug(entry.id),
  slug: toContentSlug(entry.id),
  ...entry.data,
}));
const live = portfolios.filter((portfolio) => ["quarcc-v4b", "us-long-short-equities"].includes(portfolio.slug));
---

<BaseLayout
  title="Live Funds - QUARCC"
  description="QUARCC's live paper portfolios and systematic strategies, marked to market."
>
  <div class="paper-fund-page">
    <header class="paper-fund-head">
      <p class="paper-fund-kicker">QUARCC · Live paper funds</p>
      <h1>Live Systematic Funds</h1>
      <p class="paper-fund-lede">
        Two live systematic US equity books: the market-neutral fund and the US long-short
        equities book. Both are marked against live US equity prices, with the full holdings,
        risk and performance history on each fact sheet.
      </p>
    </header>

    {live.length > 0 ? (
      <section class="paper-fund-section">
        <div class="paper-fund-section-head">
          <h2>Live funds</h2>
          <span class="paper-fund-live-pill">● Live feed</span>
        </div>
        <PaperFundClient client:load portfolios={live} />
        <div class="paper-fund-links">
          <a class="paper-fund-open" href="/paper-fund/quarcc-v4b">
            Market Neutral fact sheet →
          </a>
          <a class="paper-fund-open" href="/paper-fund/us-long-short-equities">
            US Long-Short fact sheet →
          </a>
        </div>
      </section>
    ) : null}

    <p class="paper-fund-disclaimer">
      Paper portfolio, marked with delayed market data. Research only; not investment advice.
      More QUARCC books are in research.
    </p>
  </div>
</BaseLayout>

<style>
  .paper-fund-page {
    max-width: 1100px;
    margin: 0 auto;
  }

  .paper-fund-head {
    margin: 0 0 2rem;
  }

  .paper-fund-kicker {
    margin: 0 0 0.6rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .paper-fund-head h1 {
    margin: 0 0 0.8rem;
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: 1.05;
  }

  .paper-fund-lede {
    max-width: 46rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .paper-fund-section {
    margin: 2.2rem 0;
  }

  .paper-fund-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .paper-fund-section-head h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .paper-fund-live-pill {
    color: var(--color-success);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .paper-fund-muted {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .paper-fund-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .paper-fund-open {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--color-primary);
    font-size: 0.82rem;
  }

  .paper-fund-disclaimer {
    margin: 1.6rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.5;
    opacity: 0.7;
  }
</style>
