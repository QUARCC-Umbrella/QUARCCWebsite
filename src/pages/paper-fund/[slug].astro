---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioDetailClient from "../../components/PortfolioDetailClient.jsx";
import { getPortfolios, toContentSlug } from "../../lib/content";

export async function getStaticPaths() {
  const portfolios = await getPortfolios();

  // The two live books are public; the other content entries are demo data
  // used by the internal preview.
  return portfolios
    .filter((entry) => ["quarcc-v4b", "us-long-short-equities"].includes(toContentSlug(entry.id)))
    .map((entry) => ({
    params: { slug: toContentSlug(entry.id) },
    props: {
      portfolio: {
        id: toContentSlug(entry.id),
        slug: toContentSlug(entry.id),
        ...entry.data,
      },
    },
  }));
}

const { portfolio } = Astro.props as unknown as {
  portfolio: Record<string, unknown> & { name: string; summary: string };
};
---

<BaseLayout title={`${portfolio.name} - QUARCC`} description={portfolio.summary}>
  <div class="fund-page">
    <a href="/paper-fund" class="fund-back">← All portfolios</a>
    <PortfolioDetailClient client:load portfolio={portfolio} />
  </div>
</BaseLayout>

<style>
  .fund-page {
    max-width: 1180px;
    margin: 0 auto;
  }

  .fund-back {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .fund-back:hover {
    color: var(--color-primary);
  }
</style>
