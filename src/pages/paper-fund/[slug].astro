---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperFundDetailPage from "../../components/PaperFundDetailPage.astro";
import { getPortfolios, toContentSlug } from "../../lib/content";

export async function getStaticPaths() {
  const portfolios = await getPortfolios();

  // Only the live v4b book is public for now; the other content entries are
  // demo data used by the internal preview.
  return portfolios.filter((entry) => toContentSlug(entry.id) === "quarcc-v4b").map((entry) => ({
    params: { slug: toContentSlug(entry.id) },
    props: {
      portfolio: {
        id: toContentSlug(entry.id),
        slug: toContentSlug(entry.id),
        ...entry.data,
      },
    },
  }));
}

const { portfolio } = Astro.props as unknown as {
  portfolio: Record<string, unknown> & { name: string; summary: string };
};
---

<BaseLayout title={`${portfolio.name} - Paper Fund - QUARCC`} description={portfolio.summary}>
  <PaperFundDetailPage portfolio={portfolio} />
</BaseLayout>
