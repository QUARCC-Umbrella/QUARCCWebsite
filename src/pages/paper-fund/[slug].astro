---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioDetailClient from "../../components/PortfolioDetailClient.jsx";
import { getPortfolios, toContentSlug } from "../../lib/content";
import { LIVE_FUNDS } from "../../lib/funds";

export async function getStaticPaths() {
  const portfolios = await getPortfolios();
  return portfolios
    .filter((entry) => LIVE_FUNDS.includes(toContentSlug(entry.id)))
    .map((entry) => ({
      params: { slug: toContentSlug(entry.id) },
      props: {
        portfolio: { id: toContentSlug(entry.id), slug: toContentSlug(entry.id), ...entry.data },
      },
    }));
}

const { portfolio } = Astro.props as unknown as {
  portfolio: Record<string, unknown> & { name: string; summary: string };
};
---

<BaseLayout title={`${portfolio.name} - QUARCC`} description={portfolio.summary}>
  <div class="fund-page">
    <a href="/paper-fund" class="fund-back">← All paper funds</a>
    <PortfolioDetailClient client:load portfolio={portfolio} />
  </div>
</BaseLayout>

<style>
  .fund-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
  }

  .fund-back {
    display: inline-block;
    margin: 0.5rem 0 1.6rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .fund-back:hover {
    color: var(--color-primary);
  }
</style>
