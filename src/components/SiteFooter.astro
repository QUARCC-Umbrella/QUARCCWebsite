---
import { CONTACT, FOOTER_EXPLORE, PARTNER_MAILTO, SITE_FULL_NAME } from "../lib/site";

const year = new Date().getFullYear();
const community = [
  { href: CONTACT.discord, label: "Discord" },
  { href: CONTACT.linkedin, label: "LinkedIn" },
  { href: CONTACT.instagram, label: "Instagram" },
  { href: CONTACT.github, label: "GitHub" },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" aria-label="QUARCC home">
          <img src="/quarcc-logo.png" alt="QUARCC" width="84" height="56" loading="lazy" />
        </a>
        <p>The community that builds the top quant projects in Montreal.</p>
      </div>
      <nav aria-labelledby="footer-explore">
        <h2 id="footer-explore">Explore</h2>
        <ul>
          {FOOTER_EXPLORE.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-labelledby="footer-community">
        <h2 id="footer-community">Community</h2>
        <ul>
          {community.map((item) => (
            <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a href="/join/">Join QUARCC</a></li>
          <li><a href={PARTNER_MAILTO}>Partner with us</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} QUARCC — {SITE_FULL_NAME}</span>
      <span class="mono">Made in Montréal</span>
    </div>
  </div>
  <div class="site-footer__mark" aria-hidden="true">QUARCC</div>
</footer>
